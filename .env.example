# Copy to .env.local and fill in. Without the Google values the app runs with demo data
# and manual import only.

# OAuth client (type "Web application") from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL of the app; the OAuth redirect URI is ${APP_URL}/api/gmail/callback.
APP_URL=http://localhost:4317

# Optional
# GMAIL_QUERY=from:comunicaciones@itau.com.uy
# GMAIL_INITIAL_LOOKBACK_DAYS=90
# GMAIL_POLL_MINUTES=5
# DATABASE_PATH=./data/expense-tracker.db
# SEED_DEMO_DATA=true
